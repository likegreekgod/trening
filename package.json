{
  "name": "trening",
  "private": true,
  "description": "Aplikacja treningowa dla klientów: PWA (GitHub Pages) + Google Apps Script + Arkusze",
  "scripts": {
    "test": "node --test tests/code.test.js tests/lib.test.js tests/ui.test.js",
    "test:code": "node --test tests/code.test.js",
    "validate": "node tools/validate-plan.js",
    "serve": "npx --yes serve web -l 8080",
    "gas:push": "clasp push",
    "gas:deploy": "clasp deploy -i $DEPLOYMENT_ID -d \"$(git log -1 --pretty=%s)\""
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "playwright": "^1.47.0"
  }
}
